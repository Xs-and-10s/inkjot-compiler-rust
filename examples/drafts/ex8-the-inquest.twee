do: "Step down"
do: "Call Edward Fisk"
do: "Say you were at your traps on Byall Fen"
do: "Step down"
do: "The coroner sums up"
do: "The jury retires"
expect: man_at_frame and not fisk_there
expect: not amos_at_paddles ~ ((no note passed, so the hands never came up))
expect at: verdict
expect text: "Accidental death"
expect events: ending_reached

:: the_hands_make_it_misadventure [test]
start: notice
given: set notes_passed: 1
given: set pins_out: yes
do: "Call the widow"
do: "Say that Tom was abed"
do: "Step down"
do: "Call the son"
do: "Say you checked twice, and leave it"
do: "Step down"
do: "Call the surgeon"
do: "Say the beam did it"
do: "Step down"
expect: amos_at_paddles and a_fall

:: forks_stand_in_for_what_was_said [test]
start: martha:tom_out
expect fork: "Suppose she had taken him the lantern" ~ for "Say that you stayed by the fire"
take fork: "Suppose she had taken him the lantern"
expect: gig_heard
expect: inquests == 2
